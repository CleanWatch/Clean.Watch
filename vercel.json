{
  "rewrites": [
    {
      "source": "/((?!api/|@|src/|node_modules/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "functions": {
    "api/stats/me.ts": {
      "maxDuration": 15
    }
  }
}
