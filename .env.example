# !!여기에 실제 키를 넣지 마세요!!
# 이 파일은 "코드가 실제로 읽는 환경 변수" 목록입니다.
# 로컬에서는 .env 에, 배포는 Vercel 프로젝트 환경 변수에 값을 넣습니다.

# ═══════════════════════════════════════════════════════════
#  실제 사용 중 — 아래 7개는 전부 채워야 합니다
# ═══════════════════════════════════════════════════════════

# Firebase Admin SDK (api/_lib/firebaseAdmin.ts)
# PRIVATE_KEY는 줄바꿈이 \n 문자열로 들어간 형태 그대로 따옴표로 감싸 넣습니다.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=

# Discord OAuth (api/auth/discord/index.ts, api/auth/discord/callback.ts)
# REDIRECT_URI는 Discord 개발자 포털의 Redirects 목록과 문자 단위로 일치해야 합니다.
# 로컬 개발 시에는 http://localhost:3000/api/auth/discord/callback 을 쓰고
# 포털에도 그 주소를 추가로 등록해 두어야 합니다.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Cloudflare Turnstile 서버 검증 (api/verify-captcha.ts)
#
# [로컬 개발] 아래 진짜 시크릿 대신 맨 아래 테스트 시크릿을 쓰세요.
# 위젯의 허용 호스트 목록에 localhost가 없어 실제 사이트 키로는
# 도메인 미등록(110200)으로 위젯이 뜨지 않습니다. 호스트 목록은
# Cloudflare 대시보드에서만 바꿀 수 있습니다.
# 사이트 키 쪽은 src/constants/index.ts가 알아서 갈라주므로 건드릴 필요 없습니다.
TURNSTILE_SECRET_KEY=


# Firebase App Check 로컬 개발용 디버그 토큰 (선택)
#
# localhost는 reCAPTCHA 검증을 통과할 수 없어서, App Check 적용(Enforce)이
# 켜진 뒤에는 이 토큰이 없으면 로컬에서 Firestore·로그인이 전부 막힙니다.
#
# 비워두면: 브라우저가 실행될 때 토큰을 만들어 콘솔에 출력합니다.
#           그 값을 Firebase 콘솔 > App Check > 앱 > ⋮ > 디버그 토큰 관리에
#           등록해야 하고, 사람마다·브라우저마다 따로 해야 합니다.
#           브라우저 데이터를 지우면 새로 생기므로 다시 등록해야 합니다.
#
# 채우면:   팀이 공유하는 토큰 하나만 콘솔에 등록해 두면 됩니다.
#           소유자에게 값을 받아 여기 붙여넣으세요.
#
# 이 값은 App Check를 통과하는 열쇠입니다. 공개 저장소나 공개 채널에
# 올리지 마세요. 유출되면 콘솔에서 삭제하고 새로 발급하면 됩니다.
# VITE_APPCHECK_DEBUG_TOKEN=

# ═══════════════════════════════════════════════════════════
#  현재 미사용 — 채워도 아무 일도 일어나지 않습니다
# ═══════════════════════════════════════════════════════════

# 프론트엔드 Firebase 설정은 src/firebase/firebase.ts 에 하드코딩되어 있습니다.
# env 로 옮기는 작업은 별도로 계획되어 있으며, 그 전에 Vercel 환경 변수가
# 프로덕션 빌드에 반영되는지부터 확인해야 합니다.
# (VITE_ 변수는 빌드 시점에 값이 코드로 치환되므로, 누락되면 undefined 가
#  그대로 굳어 런타임에 조용히 실패합니다.)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Turnstile 사이트 키는 src/constants/index.ts 상수입니다.
# 사이트 키는 위젯이 DOM 에 렌더링하는 공개값이라 숨길 필요가 없고,
# env 로 두면 배포 환경에 값이 빠졌을 때 위젯이 조용히 죽습니다.
# 로컬/프로덕션 분기는 그 파일이 import.meta.env.DEV 로 처리하므로
# 이 변수를 되살릴 이유는 없습니다. 채워도 코드가 읽지 않습니다.
# VITE_TURNSTILE_SITE_KEY=

# src/api/axios.ts 가 baseURL 로 읽지만, 그 axios 인스턴스를 import 하는 곳이
# 아직 없습니다. 실제로 사용하게 되면 추가하세요.
# VITE_API_BASE_URL=


# ═══════════════════════════════════════════════════════════
#  로컬 개발용 Turnstile 테스트 시크릿
# ═══════════════════════════════════════════════════════════
# 위쪽 TURNSTILE_SECRET_KEY 를 아래 값 중 하나로 바꿔 쓰세요.
# 사이트 키는 src/constants/index.ts 가 개발 모드에서 자동으로
# 1x00000000000000000000AA 로 바꾸므로 짝이 맞습니다.
#
#   1x...AA  토큰이 무엇이든 성공   ← 평소 개발용
#   2x...AA  토큰이 무엇이든 실패   ← 거절 화면 확인용
#   3x...AA  이미 사용된 토큰       ← 재사용 방지 확인용
#
# TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# TURNSTILE_SECRET_KEY="2x0000000000000000000000000000000AA"
# TURNSTILE_SECRET_KEY="3x0000000000000000000000000000000AA"
#
# 1x...AA 는 무엇이든 통과시키므로 프로덕션에 들어가면 캡챠가 무력화됩니다.
# api/verify-captcha.ts 가 VERCEL_ENV=production 일 때 이 값들을 거부합니다.
