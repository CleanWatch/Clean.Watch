rules_version = '2';

// ============================================================================
// CleanWatch Firestore 보안 규칙
//
// [중요] 프론트엔드 코드는 개발자도구에서 그대로 호출할 수 있으므로,
//        화면에서 버튼을 숨기는 것은 방어가 아닙니다.
//
// [전제] 신고 접수·삭제와 중복 검사는 api/ 서버리스 함수로 이관했습니다.
//        서버는 Admin SDK를 쓰고 Admin SDK는 이 파일을 우회하므로,
//        해당 경로들은 여기서 전부 차단해도 정상 동작합니다.
//        차단이 곧 방어입니다 — 규칙은 문서 단위 판단만 가능해서
//        "이 쓰기가 검사를 거쳤는가"를 표현할 수 없기 때문입니다.
//        따라서 이 파일을 느슨하게 되돌리면 서버 검사가 통째로 무의미해집니다.
//
// [배포] Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여넣고 게시.
//        콘솔에서 직접 수정하면 이 파일과 어긋나므로, 항상 여기서 수정한 뒤
//        복사해 붙여넣는 순서를 지켜주세요.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // 헬퍼 함수
    // ------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // 문서 소유자 본인인지
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 관리자 여부: users 문서의 role 필드를 신뢰합니다.
    //
    // [비용 주의] 규칙 안의 get()은 문서 읽기 1회로 과금됩니다.
    //             그래서 아래 규칙들은 isAdmin()을 || 의 오른쪽에 두어,
    //             일반 유저 경로에서는 호출되지 않도록 배치했습니다.
    //
    // [전제 조건] 이 함수가 안전하려면 users 문서의 role을 클라이언트가
    //             수정할 수 없어야 합니다. 아래 users 규칙에서 막고 있습니다.
    //             그 방어가 뚫리면 권한 체계 전체가 무너집니다.
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // update 요청에서 실제로 값이 바뀐 필드 목록
    // (create 시에는 resource가 없으므로 update에서만 사용할 것)
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ------------------------------------------------------------------
    // 기본값: 전부 차단
    // 아래에서 명시적으로 허용한 경로만 열립니다.
    // 새 컬렉션을 추가하면 규칙도 반드시 함께 추가해야 합니다.
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // users — 회원 정보
    //
    // 읽기: src/hooks/queries/useUser.ts:12       (본인 문서 조회)
    //       src/hooks/queries/useMyPageQueries.ts:76 (프로필 수정 전 조회)
    // 쓰기: src/hooks/queries/useAuthMutations.ts:69 (가입 시 문서 생성)
    //       src/hooks/queries/useMyPageQueries.ts:77 (프로필 수정)
    // ------------------------------------------------------------------
    match /users/{userId} {

      // 본인 문서만 읽을 수 있습니다.
      //
      // 예전에는 `if true`였습니다. 닉네임 중복 검사가 로그인 이전에 실행돼서
      // 인증 조건을 걸면 가입이 막혔기 때문입니다. 그 대가로 users 문서 전체가
      // 공개됐고, email 필드가 들어 있어 getDocs(collection(db,'users')) 한 번이면
      // 전체 회원 이메일이 털렸습니다. 규칙은 필드 단위 읽기 제한을 지원하지 않아
      // 여기서는 가릴 방법이 없었습니다.
      //
      // 중복 검사를 api/users/check-duplicate.ts로 옮겨 해결했습니다. 서버는
      // 조회할 필드를 화이트리스트로 제한하고 boolean만 돌려주므로, email이나
      // role의 존재 여부를 캐물을 수 없습니다.
      allow read: if isOwner(userId);

      // 생성: 본인 UID의 문서만, 그리고 role은 반드시 'user'
      //
      // role을 검사하지 않으면 가입 시점에 { role: 'admin' }으로 문서를 만들어
      // 스스로 관리자가 될 수 있습니다.
      //
      // 참고: Discord 로그인은 api/auth/discord/callback.ts 에서 Admin SDK로
      //       문서를 만들며, Admin SDK는 이 규칙을 우회하므로 영향받지 않습니다.
      allow create: if isOwner(userId)
                    && request.resource.data.role == 'user';

      // 수정: 본인 문서만, 그리고 권한·식별자·가입일은 건드릴 수 없음
      //
      // 이 제한이 없으면 콘솔에서
      //   updateDoc(doc(db,'users',내UID), { role: 'admin' })
      // 한 줄로 관리자 권한을 획득할 수 있습니다. isAdmin()이 이 필드를
      // 신뢰하므로 여기가 뚫리면 reports 읽기·삭제까지 전부 열립니다.
      allow update: if isOwner(userId)
                    && !changedKeys().hasAny(['role', 'uid', 'createdAt']);

      // 삭제: 클라이언트에서는 차단합니다.
      // 회원 탈퇴는 api/account/delete.ts가 Admin SDK로 처리하며,
      // Admin SDK는 이 규칙을 우회하므로 여기를 열어줄 필요가 없습니다.
      // 열어두면 세션만 있으면 아무 문서나 지울 수 있게 됩니다.
      allow delete: if false;
    }

    // ------------------------------------------------------------------
    // reports — 신고 내역
    //
    // 읽기: src/hooks/queries/useMyPageQueries.ts:38 (본인 신고 내역)
    //       src/api/admin.ts:25                      (관리자 전체 조회)
    // 쓰기: 없음 — api/reports/create.ts, api/reports/delete.ts가 처리
    // ------------------------------------------------------------------
    match /reports/{reportId} {

      // 본인이 쓴 신고만 읽을 수 있고, 관리자는 전체 열람 가능.
      //
      // 주의: Firestore는 쿼리 결과를 문서 단위로 걸러주지 않습니다.
      //       where 없이 컬렉션 전체를 조회하면(src/api/admin.ts:25) 규칙상
      //       전부 허용되지 않는 한 통째로 거부됩니다. 비관리자가 관리자 페이지에
      //       들어갔을 때 목록이 비는 이유가 이것입니다.
      allow read: if isSignedIn()
                  && (resource.data.reporterUid == request.auth.uid || isAdmin());

      // 쓰기 전면 차단. api/reports/create.ts와 api/reports/delete.ts가
      // Admin SDK로 처리하며, Admin SDK는 이 규칙을 우회합니다.
      //
      // 예전에는 create를 열어두고 reporterUid가 본인인지만 확인했습니다.
      // 그것만으로는 "중복 신고 검사를 거쳤는지", "battletags 카운트 증가와
      // 짝을 이루는지"를 알 수 없습니다. 규칙은 이 문서 하나만 보기 때문입니다.
      // 그래서 개발자도구에서 addDoc을 반복 호출하면 검사를 통째로 건너뛸 수
      // 있었습니다. 서버에서 세 단계를 한 트랜잭션으로 묶어 해결했습니다.
      allow create, update, delete: if false;
    }

    // ------------------------------------------------------------------
    // throttles — uid별 호출 횟수 (api/_lib/throttle.ts)
    //
    // 규칙을 추가하지 마세요. 문서 id가 `버킷__uid`라 열리면 누가 얼마나 썼는지가
    // 드러나고, 클라이언트가 쓸 수 있으면 제한 자체가 무의미해집니다.
    // 위의 `match /{document=**}`가 기본 차단하며 서버는 Admin SDK로 우회합니다.
    // ------------------------------------------------------------------

    // ------------------------------------------------------------------
    // battletags — 배틀태그별 누적 신고 수 (검색·랭킹의 원본 데이터)
    //
    // 읽기: src/api/search.ts:19   (배틀태그 검색)
    //       src/api/ranking.ts:13  (랭킹)
    //       src/api/stats.ts:19    (홈 통계 집계)
    // 쓰기: 없음 — api/reports/create.ts, api/reports/delete.ts가 처리
    // ------------------------------------------------------------------
    match /battletags/{tag} {

      // 검색·랭킹은 비로그인 사용자에게도 제공되는 공개 기능
      allow read: if true;

      // 쓰기 전면 차단.
      //
      // 예전에는 "정확히 +1씩만" 허용했습니다. setDoc으로 count: 9999를
      // 박아넣는 것은 막았지만, +1을 반복 호출하는 것은 막지 못했습니다.
      // 중복 신고 검사가 클라이언트에만 있었기 때문에, 개발자도구에서
      // updateDoc을 여러 번 부르면 신고 없이 무고한 사람의 숫자만 올릴 수
      // 있었습니다. 규칙으로는 해결이 불가능합니다 — "이 +1에 대응하는
      // reports 문서가 방금 생겼는가"를 물어볼 수단이 없습니다.
      //
      // 지금은 서버가 중복 검사와 두 쓰기를 한 트랜잭션으로 처리합니다.
      allow write: if false;

      // ⚠️ 하위 컬렉션 battletags/{tag}/reporters/{uid} — 규칙을 추가하지 마세요.
      //
      // 재신고 쿨다운을 재는 마커 문서입니다. 문서 id가 신고자 uid라서,
      // 열리는 순간 **누가 누구를 신고했는지**가 그대로 드러납니다.
      //
      // 위의 `allow read: if true`는 이 문서 하나에만 걸리고 하위로 내려가지
      // 않습니다. 파일 상단의 `match /{document=**} { allow read, write: if false }`가
      // 기본 차단하므로 **아무것도 안 하는 것이 맞습니다.** 서버는 Admin SDK를
      // 쓰므로 규칙을 우회합니다.
    }
  }
}
